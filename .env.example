# Public HTTPS address of this install (used to show your webhook URL).
PUBLIC_URL=https://direp.example.ir

PORT=3000
DATABASE_PATH=./data/direp.db

# Official BoxAPI Instagram API host. Leave as is.
BOXAPI_BASE_URL=https://api.sendbox.chat/api/v1

# true = log outgoing Instagram messages instead of sending them (for testing).
BOXAPI_DRY_RUN=false

# Cart-recovery timing in minutes (Meta allows messages only within 24h).
RECOVERY_STEP1_DELAY_MINUTES=120
RECOVERY_STEP2_DELAY_MINUTES=1200

# Seconds to wait for BoxAPI's follow-status answer before sending the normal DM.
FOLLOW_CHECK_TIMEOUT_SECONDS=120
